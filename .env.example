# the two ReAct agents (text only)
EPIC_AGENT_PROVIDER=openai
EPIC_AGENT_API_BASE=https://api.deepseek.com
EPIC_AGENT_MODEL=deepseek-flash
EPIC_AGENT_API_KEY=            # falls back to DEEPSEEK_API_KEY
# looking at frames
EPIC_VISION_API_BASE=https://api.deepseek.com
EPIC_VISION_MODEL=deepseek-flash
EPIC_VISION_API_KEY=           # falls back to DEEPSEEK_API_KEY
EPIC_VISION_SERVICE_NAME=DeepSeek
EPIC_VISION_COUNTRY=China
# voices
EPIC_SPEECH_PROVIDER=elevenlabs   # elevenlabs | openai (T004: elevenlabs)
GEMINI_API_KEY=                # paid tier only
OPENAI_API_KEY=                # voices, candidate in T004
ELEVENLABS_API_KEY=            # only if chosen in T004
EPIC_PROVIDER_MODE=replay      # live | record | replay
EPIC_CAP_RUN_USD=1.00
EPIC_CAP_DAY_USD=20.00
EPIC_CAP_PRE_CHECKPOINT_USD=0.30
EPIC_FRAME_FPS=4
EPIC_MOTION_MIN=0.0
EPIC_KEYFRAME_TOL_S=0.25
EPIC_SHEET_PASSES=3            # contact-sheet passes after the overview; unused in the MVP (revision 8, plan.md 4.15)
EPIC_SOUND_SNAP_S=0.25         # a sound onset this far before the chosen frame moves it there
EPIC_MIN_OUTPUT_S=20
